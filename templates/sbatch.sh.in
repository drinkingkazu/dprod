#!/bin/bash
# Generated by doraemon_prod -- campaign @CAMPAIGN@, stage @STAGE@.
# Array element i runs task i of the manifest below. Do not edit; re-submit instead.
#   manifest: @MANIFEST@
#SBATCH --job-name=@JOB_NAME@
#SBATCH --output=@LOG@
#SBATCH --error=@LOG@
@DIRECTIVES@

set -u
echo "doraemon_prod: @CAMPAIGN@ @STAGE@ array ${SLURM_ARRAY_JOB_ID:-?}_${SLURM_ARRAY_TASK_ID:-?} on $(hostname) at $(date)"
WORK_ROOT="@WORK_ROOT@"

@RUN@ --index "${SLURM_ARRAY_TASK_ID}" --work-root "${WORK_ROOT}"
rc=$?

echo "doraemon_prod: finished at $(date) with exit code ${rc}"
exit ${rc}
